# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Which Claude model to use. Defaults to claude-haiku-5-5, the fastest and cheapest.
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional. Max AI requests per visitor per hour. Defaults to 30.
# AI_RATE_LIMIT_PER_HOUR=30
